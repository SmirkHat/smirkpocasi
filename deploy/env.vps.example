# Example for API-only Dokploy/VPS (frontend on Vercel).
# Copy values into Dokploy Environment.

API_ONLY=true
FRONTEND_URL=https://pocasi.smht.eu
CORS_ORIGINS=https://pocasi.smht.eu

# Forecast accuracy benchmark, see docs/benchmark.md. Only set it where this folder survives a redeploy:
# in Dokploy, add a volume mount at this path first. docker-compose.yml already does both.
# BENCHMARK_DATA_DIR=/data/benchmark

# Optional provider keys (same as root .env.example).
# OPENWEATHERMAP_KEY=
# OPENTRIPMAP_API_KEY=
