# Replace hostnames before first start.
# DNS A/AAAA → this VPS. For nested api.pocasi.* use Cloudflare DNS-only (grey cloud)
# so Let's Encrypt works on the origin (free CF proxy SSL won't cover nested subs).

api.pocasi.smht.eu {
	encode gzip
	# reverse_proxy sets X-Forwarded-For to the visitor. /api/geo needs that; without a public
	# client IP it must not look up this VPS (that is how Frankfurt showed up as "Moje poloha").
	reverse_proxy app:3000
}

